{
  "name": "sbc-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute sbc-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute sbc-db --remote --file=./seed.sql",
    "db:init:local": "wrangler d1 execute sbc-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute sbc-db --local --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
